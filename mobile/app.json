{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "0.0.1",
    "scheme": "timekeeper",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "co.za.precisiontech.timekeeper",
      "supportsTablet": true
    },
    "android": {
      "package": "co.za.precisiontech.timekeeper",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#121F33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2878F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39d0ce2d-7322-4cb9-ab2a-539a30dbbfd6"
      }
    },
    "owner": "andrewhaine1"
  }
}
